<section
  class="relative min-h-[90vh] flex items-center justify-center overflow-hidden w-full"
  id="beranda"
>
  <!-- Background Image Container -->
  <div class="absolute inset-0 z-0">
    <img
      alt="A high-end, luxurious wooden living room featuring premium Jepara teak furniture. Soft, ambient natural lighting highlights the rich textures and deep warm tones of the wood grain. The setting is minimal yet opulent, reflecting a serene 'quiet luxury' aesthetic with cream walls and tasteful organic accents."
      class="w-full h-full object-cover object-center opacity-90"
      data-alt="A high-end, luxurious wooden living room featuring premium Jepara teak furniture. Soft, ambient natural lighting highlights the rich textures and deep warm tones of the wood grain. The setting is minimal yet opulent, reflecting a serene 'quiet luxury' aesthetic with cream walls and tasteful organic accents."
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuDNreNc4BMmLmKsrlpn7_GVozI0oAW2835c9wyog-7DUqTtM9Efs3Xdp0tz7b4Lywe2kILPAjqktiMsNKl2G4xtUmUia5BBxNL9O2DKwq9BVh7bnt8Kf-vRcaWT9NSdnYa6tf2iJlKfybkVf07_yaT-RCjaRpiM6yKYg9aYpvQidOUmzecndkuMadGYCdpoBM6ldx_9FA4qiTqj6828rnNCpQeRtX7K-5JYGd0VfHpN422d5wsILWztaSzkj3pLrzm0RvPYF4keTQ"
    />
