    </div>
  </div>
  <!-- Content -->
  <div
    class="relative z-10 w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop"
  >
    <div
      class="w-full max-w-3xl mr-auto flex flex-col items-start gap-8 py-20 pt-32"
    >
      <div class="space-y-4">
        <span
          class="font-label-sm text-label-sm text-primary uppercase tracking-widest border-b border-primary/30 pb-1"
          >Koleksi Eksklusif</span
        >
        <h1
          class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary max-w-2xl leading-tight"
        >
          Karya Seni Kayu Jati Asli Jepara untuk Hunian Anda
        </h1>
