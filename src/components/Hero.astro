      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
        Menghadirkan kehangatan alam dan kemewahan abadi ke dalam setiap sudut
        rumah Anda melalui mahakarya pengrajin terbaik Jepara.
      </p>
      <a
        class="mt-4 bg-primary text-on-primary font-label-sm text-label-sm px-8 py-4 border border-primary-container hover:bg-primary-container transition-all duration-300 uppercase tracking-wider flex items-center gap-2"
        href="#koleksi"
      >
        Jelajahi Koleksi
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
