---

---

<footer
  class="bg-primary-container text-on-primary-container w-full py-section-gap border-t border-primary/10"
  id="kontak"
>
  <div
    class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop w-full flex flex-col items-center text-center gap-unit"
  >
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-12 text-left mb-16">
      <!-- Brand Column -->
      <div class="flex flex-col gap-6">
        <span class="font-headline-md text-headline-md text-primary-fixed"
          >Aurum Teak</span
        >
        <p
          class="font-body-md text-body-md text-on-primary-container/80 max-w-xs"
        >
          Heritage Craftsmanship for Modern Living. Menyediakan furniture Jati
          premium berkualitas ekspor langsung dari pengrajin Jepara.
        </p>
      </div>
      <!-- Contact Info -->
      <div class="flex flex-col gap-4">
        <h4
          class="font-label-sm text-label-sm uppercase tracking-widest text-primary-fixed mb-2"
        >
          Kontak &amp; Lokasi
        </h4>
        <p
          class="font-body-md text-body-md text-on-primary-container/80 flex items-start gap-2"
        >
          <span
            class="material-symbols-outlined text-primary-fixed text-sm mt-1"
            >location_on</span
          >
          Jl. Sentra Ukir Jepara No. 88, Tahunan, Kabupaten Jepara, Jawa Tengah 59427
        </p>
        <p
          class="font-body-md text-body-md text-on-primary-container/80 flex items-center gap-2 mt-2"
        >
          <span class="material-symbols-outlined text-primary-fixed text-sm"
            >schedule</span
          >
          Senin - Sabtu: 08:00 - 17:00 WIB
        </p>
      </div>
      <!-- CTA -->
      <div class="flex flex-col gap-6 items-start md:items-end">
        <a
          class="bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm px-8 py-4 border border-transparent hover:bg-primary-fixed-dim transition-all duration-300 uppercase tracking-wider flex items-center gap-2 w-full md:w-auto justify-center"
          href="https://wa.me/1234567890"
        >
          <span class="material-symbols-outlined text-lg">chat</span>
          WhatsApp Kami
        </a>
        <div class="flex gap-4 mt-4">
          <a
            class="text-on-primary-container/70 hover:text-primary-fixed-dim transition-colors opacity-80 hover:opacity-100"
            href="#"><span class="material-symbols-outlined">share</span></a
          >
          <a
            class="text-on-primary-container/70 hover:text-primary-fixed-dim transition-colors opacity-80 hover:opacity-100"
            href="#"
            ><span class="material-symbols-outlined">photo_camera</span></a
          >
        </div>
      </div>
    </div>
    <div
      class="w-full border-t border-primary/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="font-body-md text-body-md text-on-primary-container/70">
        © 2024 Aurum Teak Jepara. Heritage Craftsmanship for Modern Living.
      </p>
      <div class="flex gap-6">
        <a
          class="font-label-sm text-label-sm text-on-primary-container/70 hover:text-primary-fixed-dim transition-colors"
          href="#">Kebijakan Privasi</a
        >
        <a
          class="font-label-sm text-label-sm text-on-primary-container/70 hover:text-primary-fixed-dim transition-colors"
          href="#">Syarat &amp; Ketentuan</a
        >
        <a
          class="font-label-sm text-label-sm text-on-primary-container/70 hover:text-primary-fixed-dim transition-colors"
          href="#">Katalog Digital</a
        >
      </div>
    </div>
  </div>
</footer>
