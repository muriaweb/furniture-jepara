---

<section
  class="py-section-gap px-margin-mobile md:px-margin-desktop bg-surface-container-low"
  id="koleksi"
>
  <div class="max-w-container-max mx-auto flex flex-col gap-12">
    <div class="flex flex-col gap-4 text-center items-center">
      <span
        class="font-label-sm text-label-sm text-secondary uppercase tracking-widest"
        >Koleksi Pilihan</span
      >
      <h2 class="font-headline-lg text-headline-lg text-primary">
        Karya Terbaik Kami
      </h2>
      <div class="w-12 h-px bg-primary/30 mt-2"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Product 1 -->
      <div
        class="group bg-surface rounded-lg overflow-hidden border border-outline-variant/20 hover:shadow-lg transition-all duration-300"
      >
        <div class="aspect-[4/3] overflow-hidden bg-surface-variant relative">
          <img
            alt="Set Meja Makan Royal - Luxurious solid teak dining table set in a warm, well-lit dining room"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuA2G0P1jyzyXO_zAyZnBUgLYnKLCyb22Uz_BnU09Gih6QETUJ5lBEQHG1yDXihaguDZcrU0aNWY9b4YbwTqb14EIloWLb4fDQjm7ita8E60WxDtZ5Ab3sEqC40PG9hTT64OHMOJGJcCBUqI1Kpok1o4gk-Slh1HvB-Yg97TrcT4wOBexJR7bk-NlJdFyJQ2q6NZ0IDqp4ryvZZ8XdINQCo34GTGzGu-vNjf0ybMxlnC6QIw4eJvR6Jv7nD_JunkV2-tyIz8A2Y2cQ"
          />
          <div
            class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
          </div>
        </div>
        <div class="p-6 flex flex-col gap-4">
          <h3 class="font-headline-md text-xl text-primary">
            Set Meja Makan Royal
          </h3>
          <p class="font-body-md text-on-surface-variant text-sm line-clamp-2">
            Meja makan elegan berbahan kayu jati solid dengan sentuhan akhir
            premium, cocok untuk ruang makan mewah Anda.
          </p>
          <a
            class="inline-flex items-center gap-2 text-primary font-label-sm text-label-sm uppercase tracking-wider mt-2 group-hover:text-primary-container transition-colors"
            href="#"
            >Detail Produk <span
              class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1"
              >arrow_forward</span
            ></a
          >
        </div>
      </div>
      <!-- Product 2 -->
      <div
        class="group bg-surface rounded-lg overflow-hidden border border-outline-variant/20 hover:shadow-lg transition-all duration-300"
      >
        <div class="aspect-[4/3] overflow-hidden bg-surface-variant relative">
          <img
            alt="Kursi Tamu Minimalis - Modern, minimal teak sofa with clean lines in a bright living room"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQVMQDbEcgaDcVOrS1_yAXfFdEhS9YwTdTWXMRC2tbKJQWYdBGLZaa6y9NgbB0xaYu6r2XRIBVSSVSeU2yWI60wU9KshLHQ-oLO1CEvEfFHHUDKdv4r2R1FG_-YoH0i36bhc0vEOI0XI-24w51cGZLNK5nXJh-gy0EE1Rv8dxfExNXggDmfUaJcTYy_mYFhKqlYorqWE47O3LLD8z5McjEyblVbN78nI1_YXZCgcmnJ4fQRBWzOkVUc9n5UWfB7MAOIynVY79deg"
          />
          <div
            class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
          </div>
        </div>
        <div class="p-6 flex flex-col gap-4">
          <h3 class="font-headline-md text-xl text-primary">
            Kursi Tamu Minimalis
          </h3>
          <p class="font-body-md text-on-surface-variant text-sm line-clamp-2">
            Desain modern minimalis yang mengedepankan kenyamanan tanpa
            mengorbankan estetika keindahan kayu jati alami.
          </p>
          <a
            class="inline-flex items-center gap-2 text-primary font-label-sm text-label-sm uppercase tracking-wider mt-2 group-hover:text-primary-container transition-colors"
            href="#"
            >Detail Produk <span
              class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1"
              >arrow_forward</span
            ></a
          >
        </div>
      </div>
      <!-- Product 3 -->
      <div
        class="group bg-surface rounded-lg overflow-hidden border border-outline-variant/20 hover:shadow-lg transition-all duration-300"
      >
        <div class="aspect-[4/3] overflow-hidden bg-surface-variant relative">
          <img
            alt="Lemari Pakaian Jati Klasik - Beautifully carved classic teak wardrobe showing heritage craftsmanship"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAuceU_Dd3h4npcD3--9vQCk8Qdi4ejZNZty_b5FxE6bn9k66ITwHOL7pj49QpUtQZzl2aRKiD20evV5Tho77UYcvpPoD8o3wrTvehBI0hugX5W5H1qBeu5Bya-CCWB1zW7unmMRcwRs4zYuAqP1Imx_01DWt5CM_zd_3DHNsdxrMhysz6Mzi4Rf0GeifhBq8T_8WHrGl8OZwHfkvHV8N2hxmLZ4MbuD_nV4cNf8clZbIyYwV8hkkDYst_0xDE6L9tJ9tRmiQTHhQ"
          />
          <div
            class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
          </div>
        </div>
        <div class="p-6 flex flex-col gap-4">
          <h3 class="font-headline-md text-xl text-primary">
            Lemari Pakaian Jati Klasik
          </h3>
          <p class="font-body-md text-on-surface-variant text-sm line-clamp-2">
            Lemari pakaian berukuran besar dengan ukiran Jepara otentik yang
            menawan, memberikan kesan megah di kamar tidur.
          </p>
          <a
            class="inline-flex items-center gap-2 text-primary font-label-sm text-label-sm uppercase tracking-wider mt-2 group-hover:text-primary-container transition-colors"
            href="#"
            >Detail Produk <span
              class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1"
              >arrow_forward</span
            ></a
          >
        </div>
      </div>
    </div>
  </div>
</section>
